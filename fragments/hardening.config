# ==============================================================================
# hardening.config – kernel hardening on top of the Ubuntu mainline baseline
# ==============================================================================
# The baseline already carries KASLR, STACKPROTECTOR_STRONG, FORTIFY_SOURCE,
# HARDENED_USERCOPY, SLAB_FREELIST_*, INIT_ON_ALLOC_DEFAULT_ON, LIST_HARDENED,
# STRICT_*_RWX and STRICT_DEVMEM. This fragment adds low-cost options; the
# rejected ones are listed in todo.md under "Decided against".
# ==============================================================================

# Turn corruption detected by LIST_HARDENED into a BUG instead of a warning
CONFIG_BUG_ON_DATA_CORRUPTION=y

# /dev/mem: block access to MMIO ranges an active driver has claimed
CONFIG_IO_STRICT_DEVMEM=y

# Keep slab caches separate, so a heap overflow cannot reach objects of other
# types sharing a merged cache. Revert at boot: slab_merge
# CONFIG_SLAB_MERGE_DEFAULT is not set

# No vsyscall page at all; only pre-2013 static binaries need it.
# Revert at boot: vsyscall=xonly
# CONFIG_LEGACY_VSYSCALL_XONLY is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
