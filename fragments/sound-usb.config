# ==============================================================================
# sound-usb.config – the audio this system actually uses
# ==============================================================================
# Hardware:
#   Sound:   Onboard Realtek ALC4080 – attached over USB (0db0:d6e7), not HDA.
#            X670E wires the ALC4080 to an internal USB port, so the analog
#            outputs are driven by snd_usb_audio.
#   HeadSet: BeyerDynamic MMX 200 (USB wireless adapter / Bluetooth)
#   Webcam:  Logitech C920 microphone (USB audio)
#
# Every audio device here is USB. Display and APU audio are switched off in
# sound-hdmi.config, which also covers the iGPU side.
# ==============================================================================

# --- USB audio ---------------------------------------------------------------
CONFIG_SND_USB_AUDIO=m
# CONFIG_SND_USB_UA101 is not set
# CONFIG_SND_USB_USX2Y is not set
# CONFIG_SND_USB_CAIAQ is not set
# CONFIG_SND_USB_US122L is not set
# CONFIG_SND_USB_US144MKII is not set
# CONFIG_SND_USB_6FIRE is not set
# CONFIG_SND_USB_HIFACE is not set

# --- PipeWire / PulseAudio basics --------------------------------------------
CONFIG_SND_TIMER=m
CONFIG_SND_PCM=m

# --- No Realtek HDA codec on this board --------------------------------------
# The ALC4080 is USB-attached, so snd_hda_codec_realtek has nothing to bind to.
# CONFIG_SND_HDA_CODEC_REALTEK is not set
